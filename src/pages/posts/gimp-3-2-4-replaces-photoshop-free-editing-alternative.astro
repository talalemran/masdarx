---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostLayout from "@/components/PostLayout.astro";

const postModules = import.meta.glob("../posts/*.astro", { eager: true });
const allPosts = Object.values(postModules)
    .map((mod: any) => mod.post)
    .sort((a, b) => b.pubDate.valueOf() - a.pubDate.valueOf());

export const post = {
    slug: "gimp-3-2-4-replaces-photoshop-free-editing-alternative",
    title: "ألغيت اشتراك GIMP:  Photoshop كان كل ما احتجته",
    description:
        "بعد اختبار GIMP 3.2.4 على المهام اليومية — القص، تغيير الحجم، معالجة دفعات — ألغت كاتبة اشتراك Photoshop بـ 22.99 دولار شهريًا. إليك لماذا أصبح المحرر المجاني كافياً تماماً.",
    keywords: [
        "GIMP",
        "جيمب",
        "Photoshop",
        "فوتوشوب",
        "محرر صور",
        "Image editing",
        "مجاني",
        "مفتوح المصدر",
        "Batcher plugin",
        "Layers",
    ],
    category: "برامج",
    author: "فريق مصدر إكس",
    date: "30 يوليو 2026",
    pubDate: new Date("2026-07-30"),
    tags: ["GIMP", "Photoshop", "محرر صور", "مجاني", "مفتوح المصدر"],
    thumbnail: "/images/gimp-3-2-4-replaces-photoshop-free-editing-alternative.webp",
};
---

<BaseLayout
    title={post.title}
    description={post.description}
    keywords={post.keywords}
    canonical={`/posts/${post.slug}/`}
    ogImage={post.thumbnail}
    ogType="article"
>
    <PostLayout {post} allPosts={allPosts}>
        <p>
            ألغيت اشتراك Photoshop بـ 22.99 دولار شهرياً بعد أسابيع قليلة —
            والسبب كان واضحاً: <strong>GIMP 3.2.4</strong> كان يفعل كل ما أحتاجه بالفعل.
            كنت أستخدم Photoshop بشكل أساسي للعمل اليومي — القص والتغيير والتحسينات
            البسيطة — والمحرر المجاني أصبح يتعامل معها دون أي مشاكل.
        </p>

        <h2>القص ذو النسبة الثابتة كان البداية فقط</h2>

        <p>
            أقص الصور يومياً لأسباب عملية — حوالي 50 صورة أسبوعياً. معظمها تُقص
            بنسبة 16:9 أو 3:2. في GIMP، وجدت أن النسبة الثابتة تبقى محفوظة حتى
            بعد إغلاق البرنامج وإعادة تشغيل الحاسوب — وهذه تفصيلة صغيرة وفرت
            عليّ الكثير من الوقت.
        </p>

        <p>
            لكن GIMP لم يقتصر على القص. استطعت تغيير حجم الصور، تدويرها، وتصحيح
            الصور المائلة. كل هذه العمليات التي أفعلها يومياً كانت موجودة وسهلة
            الاستخدام. حتى ضبط السطوع والتباين كان يعمل بنفس كفاءة Photoshop.
            والفارق؟ GIMP مجاني بينما Photoshop يكلفني شهرياً.
        </p>

        <h2>البلاجنات المجانية أقنعتني بالبقاء</h2>

        <p>
            عندما حاولت استخدام Batcher plugin لمعالجة الصور بشكل جماعي، اكتشفت
            أن التثبيت يتطلب عملاً يدويًا أكثر من Photoshop — تحميل الملف ونسخه
            في مجلد البلاجنات الصحيح وإعادة تشغيل البرنامج. لكن هذا حدث مرة
            واحدة فقط.
        </p>

        <p>
            بعد ذلك، كان بإمكاني معالجة عشرات الصور معاً. حول Batcher ملفات PNG
            إلى JPG وحفظها في مجلد منفصل، دون تعديل الأصلية. كل هذا مجاناً. نعم،
            بعض بلاجنات Photoshop مجانية أيضاً، لكن الفارق أنني لا أحتاج اشتراك
            Photoshop مدفوع لاستخدام GIMP و Batcher معاً.
        </p>

        <h2>الطبقات أظهرت لي أن GIMP يتجاوز الأساسيات</h2>

        <p>
            عندما بدأت باستخدام الطبقات — نسخ الصورة وتحويلها لأبيض وأسود، إضافة
            قناع، واستعادة بعض الألوان الأصلية بفرشاة سوداء — أدركت أن GIMP ليس
            محرراً بسيطاً. مع تعديل الشفافية لرؤية قوة التأثير، حصلت على النتيجة
            التي أردتها.
        </p>

        <p>
            نعم، Photoshop يفعل كل هذا وأكثر. لكن لم أكن أحاول إثبات أن GIMP
            يعادل Photoshop في كل ميزة. كنت أتحقق ما إذا كان يعطيني التحكم
            الكافي على نوع التحرير الذي أفعله والأشياء التي أريد تعلمها. وفعلاً،
            فعل.
        </p>

        <h2>لا تحتاج GIMP لهزيمة Photoshop — فقط لتكون كافية</h2>

        <p>
            بدأت بالتحريرات الأساسية وتطورت من هناك. القص، ثم البلاجنات، ثم
            الطبقات. أنجزت عملي دون فتح Photoshop مجدداً. عندما أدركت أن GIMP
            يغطي كل الميزات التي استخدمتها في Photoshop، لم يعد هناك منطق لدفع
            22.99 دولار شهرياً.
        </p>

        <p>
            إذا كنت تسأل نفسك إن كانت GIMP كافية لاحتياجاتك، ابدأ بالعمليات
            الأساسية التي تفعلها أكثر من غيرها. إن وجدت نفسك تنجز كل شيء في
            GIMP، قد يكون الوقت قد حان لإلغاء ذلك الاشتراك.
        </p>

        <h3>المصدر:</h3>
        <p>
            <a
                href="https://www.makeuseof.com/gimp-replaced-photoshop/"
                target="_blank"
                rel="noopener noreferrer"
            >
                MakeUseOf
            </a>
        </p>
    </PostLayout>
</BaseLayout>
