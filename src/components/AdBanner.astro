---
import { ads } from "@/data/ads";

const ad = ads[0];
---

<div class="my-8">
    <h2 class="font-heading text-lg font-bold text-navy dark:text-white mb-3">فاصل اعلاني</h2>
    <a
        href={ad.link}
        target="_blank"
        rel="noopener noreferrer sponsored"
        class="block rounded-xl overflow-hidden border border-navy-100 dark:border-zinc-800 hover:border-accent dark:hover:border-zinc-600 transition-colors no-underline group"
        data-ad-slot
    >
        <img
            src={ad.banner}
            alt={ad.title}
            width="728"
            height="180"
            class="w-full h-auto"
            loading="lazy"
        />
        <div class="p-4">
            <h3 class="font-heading text-base font-bold text-navy dark:text-white group-hover:text-accent dark:group-hover:text-zinc-300 transition-colors">
                {ad.title}
            </h3>
            <p class="font-body text-base text-navy-400 dark:text-zinc-400 mt-1">
                {ad.description}
            </p>
        </div>
    </a>
</div>
