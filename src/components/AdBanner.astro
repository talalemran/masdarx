---
import { ads } from "@/data/ads";

const ad = ads[0];
---

<div class="my-4">
    <h2>فاصل اعلاني</h2>
    <div class="block rounded-xl overflow-hidden transition-colors no-underline group">
        <img
            src={ad.banner}
            alt={ad.title}
            width="728"
            height="180"
            class="w-full h-auto"
            loading="lazy"
        />
        <div class="p-4">
            <h3>
                {ad.title}
            </h3>
            <p>
                {ad.description}
                <br />
                <a
                href={ad.link}
                target="_blank"
                rel="noopener noreferrer sponsored"
            >
                ابدأ الآن
            </a>
            </p>
            
        </div>
    </div>
</div>
    </a>
</div>
