---
import { ads } from "@/data/ads";

const ad = ads[0];
---

<div class="my-8">
    <h2>فاصل اعلاني</h2>
    <div class="block rounded-xl overflow-hidden transition-colors no-underline group">
        <img
            src={ad.banner}
            alt={ad.title}
            width="728"
            height="180"
            class="w-full h-auto"
            loading="lazy"
        />
        <div class="p-4">
            <h3>
                {ad.title}
            </h3>
            <p>
                {ad.description}
            </p>
            <a
                href={ad.link}
                target="_blank"
                rel="noopener noreferrer sponsored"
                class="inline-block mt-4 px-6 py-2 bg-navy dark:bg-navy-700 text-white font-body font-medium rounded-lg hover:bg-accent hover:text-white dark:hover:bg-navy-600 transition-colors no-underline"
            >
                ابدأ الآن
            </a>
        </div>
    </div>
</div>
    </a>
</div>
