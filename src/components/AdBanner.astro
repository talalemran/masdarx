---
import { ads } from "@/data/ads";

const ad = ads[0];
---

<div class="my-8">
    <h2 class="font-heading text-lg font-bold text-navy dark:text-white mb-3">فاصل اعلاني</h2>
    <a
        href={ad.link}
        target="_blank"
        rel="noopener noreferrer sponsored"
        class="block rounded-xl overflow-hidden transition-colors no-underline group"
        data-ad-slot
    >
        <img
            src={ad.banner}
            alt={ad.title}
            width="728"
            height="180"
            class="w-full h-auto"
            loading="lazy"
        />
        <div class="p-4">
            <h3 class="font-heading text-lg font-bold text-navy dark:text-white">
                {ad.title}
            </h3>
            <p class="mt-2 text-sm text-gray-700 dark:text-gray-300">
                {ad.description}
            </p>
        </div>
    </a>
</div>
