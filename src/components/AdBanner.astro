---
import { ads } from "@/data/ads";

const ad = ads[0];
---

<a
    href={ad.link}
    target="_blank"
    rel="noopener noreferrer sponsored"
    class="block my-8 rounded-xl overflow-hidden border border-navy-100 dark:border-zinc-800 hover:border-accent dark:hover:border-zinc-600 transition-colors no-underline group"
    data-ad-slot
>
    <img
        src={ad.banner}
        alt={ad.title}
        width="728"
        height="180"
        class="w-full h-auto"
        loading="lazy"
    />
    <div class="p-4">
        <p class="font-heading text-sm font-bold text-navy dark:text-white group-hover:text-accent dark:group-hover:text-zinc-300 transition-colors">
            {ad.title}
        </p>
        <p class="font-body text-xs text-navy-400 dark:text-zinc-400 mt-1">
            {ad.description}
        </p>
    </div>
</a>
