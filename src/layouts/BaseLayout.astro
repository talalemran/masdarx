---
import MetaTags from "@/components/seo/MetaTags.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import "@/styles/global.css";

export interface Props {
  title: string;
  description: string;
  keywords?: string[];
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  noIndex?: boolean;
}

const {
  title,
  description,
  keywords = [],
  canonical,
  ogImage,
  ogType,
  noIndex = false,
} = Astro.props;
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/cairo-arabic.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/cairo-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/tajawal-300-arabic.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/tajawal-300-latin.woff2" as="font" type="font/woff2" crossorigin />
